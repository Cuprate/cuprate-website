---
import Layout from "./Layout.astro";
import "../styles/prose.css";
import FormattedDate from '../components/layout/FormattedDate.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
}

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<Layout
	title={title}
	description={description}
	image={heroImage}
	width="article"
>
	<article>
		<div class="hero-image">
			{heroImage && <img width={960} height={510} src={heroImage} alt="" />}
		</div>
		<div class="prose">
			<a class="arrow-link" href="/blog">
				<span class="arrow-link__arrow" aria-hidden="true">&lt;-</span>
				Back to blog
			</a>
			<div class="title">
				<div>
					<span class="date-chip">
						<span class="date-chip__prefix">Date</span>
						<span class="date-chip__date">
							<FormattedDate date={pubDate} />
						</span>
					</span>
					{updatedDate && (
						<div class="last-updated-on">
							Last updated on <FormattedDate date={updatedDate} />
						</div>
					)}
				</div>
				<h1>{title}</h1>
				<hr />
			</div>
			<slot />
		</div>
	</article>
</Layout>

<style>
	main {
		width: calc(100% - 2em);
		max-width: 100%;
		margin: 0;
	}

	.hero-image {
		width: 100%;
	}

	.hero-image img {
		display: block;
		margin: 0 auto;
	}

	.back {
		font-size: 0.8rem;
		color: rgb(var(--gray));
		margin-bottom: 2.5rem;
	}

	.back:hover {
		color: #7d9bff;
	}

	.back:hover .arrow-link__arrow {
		transform: translateX(-4px);
	}

	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}

	.title h1 {
		margin: 0 0 0.5em 0;
		font-family: 'Atkinson', sans-serif;
		letter-spacing: -0.01em;
		line-height: 1.25;
		text-shadow: none;
	}

	.title hr {
		border: none;
		border-top: 1px dashed rgb(34, 41, 57);
	}

	.date-chip {
		display: inline-flex;
		align-items: baseline;
		gap: 0.6rem;
		padding: 0.65rem 1rem;
		margin-bottom: 1.75rem;
		border: 1px dashed rgb(34, 41, 57);
		font-family: 'Atkinson', sans-serif;
		font-weight: 700;
		font-size: 0.9rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.date-chip__prefix {
		font-size: 0.65rem;
		letter-spacing: 0.18em;
		color: #7d9bff;
	}

	.date-chip__prefix::after {
		content: '//';
		margin-left: 0.6rem;
		color: rgb(34, 41, 57);
	}

	.date-chip__date {
		color: #e6edf3;
	}

	.last-updated-on {
		margin-top: 0.75rem;
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
</style>
