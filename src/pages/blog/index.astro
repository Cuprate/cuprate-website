---
import BaseHead from '../../components/layout/BaseHead.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/layout/FormattedDate.astro';
import BlogRssCta from '../../components/blog/BlogRssCta.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1 class="section__title">Blog</h1>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.slug}/`}>
									<img width={720} height={360} src={post.data.heroImage} alt="" />
									<h4 class="title">{post.data.title}</h4>
									<div class="meta">
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<span class="arrow" aria-hidden="true">-&gt;</span>
									</div>
								</a>
							</li>
						))
					}

				</ul>
			</section>
		</main>
		<BlogRssCta />
		<Footer from="#070c12" />
	</body>
</html>

<style>
	main {
		width: 1100px;
	}

	ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}

	ul li {
		display: flex;
	}

	ul li a {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1rem;
		border: 1px dashed rgb(34, 41, 57);
		text-decoration: none;
		transition:
			background 100ms steps(2),
			border-color 100ms steps(2);
	}

	ul li a:hover {
		background: rgba(30, 86, 207, 0.06);
		border-color: rgba(30, 86, 207, 0.5);
	}

	ul li img {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 0.9rem;
	}

	.title {
		margin: 0;
		font-family: "Atkinson", sans-serif;
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: 0.04em;
		line-height: 1.4;
		color: #e6edf3;
	}

	ul li a:hover .title {
		color: #7d9bff;
	}

	.meta {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-top: auto;
		padding-top: 0.75rem;
		border-top: 1px dashed rgb(34, 41, 57);
	}

	.date {
		margin: 0;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.arrow {
		margin-left: auto;
		font-family: "Atkinson", sans-serif;
		font-weight: 700;
		font-size: 0.85rem;
		color: rgb(var(--gray));
		transition:
			transform 100ms steps(2),
			color 100ms steps(2);
	}

	ul li a:hover .arrow {
		transform: translateX(4px);
		color: #7d9bff;
	}

	@media (max-width: 1000px) {
		ul {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		ul {
			grid-template-columns: 1fr;
		}
	}
</style>
