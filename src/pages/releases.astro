---
import BaseHead from "../components/layout/BaseHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import PixelButton from "../components/ui/PixelButton.astro";
import { SITE_TITLE } from "../consts";
import { builds } from "../data/platforms";
import Icon from "../components/ui/Icon.astro";

const selectedLabelRules = `${builds
	.map((_, i) => `.download:has(#plat-${i}:checked) .dl-${i}`)
	.join(",")}{display:inline}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Releases | ${SITE_TITLE}`}
			description="Download Cuprate releases for your platform."
		/>
	</head>
	<body>
		<Header />
		<main class="full">
			<section class="section download">
				<h1 class="page-title">Download Cuprate</h1>
				<p class="download__sub">Pre-built binaries for every platform.</p>

				<div class="download__cta">
					<PixelButton big disabled badge="Sometime soon">
						{
							builds.map((p, i) => (
								<span class={`dl-label dl-${i}`}>Download for {p}</span>
							))
						}
					</PixelButton>
				</div>

				<div class="select">
					<select class="platform-select" aria-label="Choose a platform">
						{
							builds.map((p, i) => (
								<option id={`plat-${i}`} value={i} selected={i === 0}>
									{p}
								</option>
							))
						}
					</select>
					<span class="select__caret">
						<Icon name="chevron-down" size="1rem" />
					</span>
				</div>

				<p class="download__meta">
					<span>File size: <strong>not big</strong></span>
					<span class="download__sep" aria-hidden="true">//</span>
					<span>Release date: <strong>in 2 weeks</strong> (every 2 weeks)</span>
				</p>
			</section>

			<section class="section">
				<div class="split">
					<div class="split__col">
						<h2 class="split__title">
							<Icon name="docker" size="1.7rem" color="#7d9bff" />
							Docker deployment
						</h2>
						<p>
							Cuprate can be deployed with Docker. The Dockerfile lives at the
							root of the repository and builds a ready-to-run node image on
							Alpine Linux.
						</p>
						<a
							class="arrow-link"
							href="https://github.com/Cuprate/cuprate/blob/main/Dockerfile"
							target="_blank"
							rel="noopener"
						>
							View the Dockerfile
							<span class="arrow-link__arrow" aria-hidden="true">-&gt;</span>
						</a>
					</div>
					<div class="split__col">
						<h2 class="split__title">
							<Icon name="book" size="1.7rem" color="#7d9bff" />
							Getting started
						</h2>
						<p>
							Once you have downloaded Cuprate, You will need to read
							documentation to learn how to configure and run your node
							correctly.
						</p>
						<a
							class="arrow-link"
							href="https://user.cuprate.org"
							target="_blank"
							rel="noopener"
						>
							Read the documentation
							<span class="arrow-link__arrow" aria-hidden="true">-&gt;</span>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style is:inline set:html={selectedLabelRules}></style>

<style>
	.download {
		padding: 5rem 1rem 4rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.page-title {
		font-family: "Atkinson", sans-serif;
		font-weight: 700;
		font-size: clamp(1.6rem, 3.5vw, 2.5rem);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #e6edf3;
		margin: 0 0 1rem;
	}

	.download__sub {
		font-size: 1.15rem;
		color: rgb(var(--gray));
		margin: 0 0 3rem;
	}

	.download__cta {
		margin-bottom: 1.5rem;
	}

	.select {
		position: relative;
		display: inline-block;
		margin-bottom: 2rem;
	}

	/* Overlays the select, so clicks must fall through. */
	.select__caret {
		position: absolute;
		right: 0.9rem;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		color: #7d9bff;
		pointer-events: none;
	}

	.platform-select {
		appearance: none;
		-webkit-appearance: none;
		min-width: 15rem;
		font-family: "Atkinson", sans-serif;
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.75rem 2.6rem 0.75rem 1.1rem;
		background-color: transparent;
		border: 1px dashed rgb(34, 41, 57);
		color: #7d9bff;
		cursor: pointer;
		transition:
			background-color 100ms steps(2),
			border-color 100ms steps(2),
			color 100ms steps(2);
	}

	.platform-select:hover,
	.platform-select:focus-visible {
		background-color: rgba(30, 86, 207, 0.06);
		border-color: rgba(30, 86, 207, 0.5);
		color: #e6edf3;
		outline: none;
	}

	.platform-select option {
		background: #010409;
		color: #e6edf3;
	}

	@supports (appearance: base-select) {
		.platform-select,
		.platform-select::picker(select) {
			appearance: base-select;
		}

		.platform-select::picker-icon {
			display: none;
		}

		.platform-select::picker(select) {
			background: #010409;
			border: 3px solid rgb(34, 41, 57);
			box-shadow: 8px 8px 0 rgba(1, 4, 9, 0.8);
			padding: 0;
		}

		.platform-select option {
			font-family: "Atkinson", sans-serif;
			font-weight: 700;
			font-size: 0.85rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			padding: 0.75rem 1.25rem;
			color: rgb(var(--gray));
			border-bottom: 1px dashed rgb(34, 41, 57);
		}

		.platform-select option:last-child {
			border-bottom: none;
		}

		.platform-select option:hover,
		.platform-select option:focus-visible {
			background: rgba(30, 86, 207, 0.06);
			color: #7d9bff;
			outline: none;
		}

		.platform-select option:checked {
			color: #7d9bff;
		}

		.platform-select option::checkmark {
			color: #7d9bff;
		}
	}

	.dl-label {
		display: none;
	}

	.download__meta {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		font-size: 0.95rem;
		color: rgb(var(--gray));
		margin: 0;
	}

	.download__meta strong {
		color: #e6edf3;
		font-weight: 700;
	}

	.download__sep {
		color: rgb(34, 41, 57);
	}

	.split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
	}

	.split__col + .split__col {
		border-left: 1px dashed rgb(34, 41, 57);
		padding-left: 3rem;
	}

	.split__title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-family: "Atkinson", sans-serif;
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #e6edf3;
		margin: 0 0 1rem;
	}

	.split__col p {
		font-size: 1.05rem;
		line-height: 1.6;
		color: rgb(var(--gray));
		margin: 0 0 1.5rem;
	}

	@media (max-width: 720px) {
		.split {
			grid-template-columns: 1fr;
		}

		.split__col + .split__col {
			border-left: none;
			padding-left: 0;
			border-top: 1px dashed rgb(34, 41, 57);
			padding-top: 2.5rem;
		}
	}
</style>
