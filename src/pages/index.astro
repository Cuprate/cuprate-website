---
import BaseHead from "../components/layout/BaseHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import PixelHero from "../components/home/PixelHero.astro";
import LatestPostBar from "../components/home/LatestPostBar.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import LinkCard from "../components/ui/LinkCard.astro";
import PlatformSupport from "../components/home/PlatformSupport.astro";
import Contributors from "../components/home/Contributors.astro";
import CommunityBar from "../components/home/CommunityBar.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="full">
			<PixelHero />

			<LatestPostBar />

			<section class="section">
				<div class="features">
					<FeatureCard
						title="Rust Native"
						description="Written from the ground up in Rust. Memory safety, optimal concurrency and asynchronous operations makes every part of the node."
					>
						<span
							slot="icon"
							class="icon-mask"
							style="--icon: url(/img/rust.svg)"
							aria-hidden="true"></span>
					</FeatureCard>
					<FeatureCard
						title="Modular Design"
						description="Consensus, database, P2P and RPC live in standalone MIT-Licensed crates that you can reuse for your own needs."
					>
						<svg
							slot="icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path
								d="M14 4a1 1 0 0 1 1 -1h5a1 1 0 0 1 1 1v5a1 1 0 0 1 -1 1h-5a1 1 0 0 1 -1 -1l0 -5"
							></path>
							<path
								d="M3 14h12a2 2 0 0 1 2 2v3a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2h3a2 2 0 0 1 2 2v12"
							></path>
						</svg>
					</FeatureCard>
					<FeatureCard
						title="Security First"
						description="An alternative node implementation built with security at its core, auditing and hardening the Monero network through diversity."
					>
						<svg
							slot="icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path
								d="M11.46 20.846a12 12 0 0 1 -7.96 -14.846a12 12 0 0 0 8.5 -3a12 12 0 0 0 8.5 3a12 12 0 0 1 -.09 7.06"
							></path>
							<path d="M15 19l2 2l4 -4"></path>
						</svg>
					</FeatureCard>
					<div class="features__wide">
						<PlatformSupport />
					</div>
				</div>
			</section>

			<section class="section">
				<h2 class="section__title">Explore</h2>
				<div class="explore">
					<div class="explore__main">
						<LinkCard
							title="Documentation"
							description="User and architecture books for Cuprate and the Monero protocol."
							badge="In Progress"
						>
							<svg
								slot="icon"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
								<path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0"></path>
								<path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0"></path>
								<path d="M3 6l0 13"></path>
								<path d="M12 6l0 13"></path>
								<path d="M21 6l0 13"></path>
							</svg>
							<div class="docs-links">
								<a
									class="arrow-link"
									href="https://user.cuprate.org"
									target="_blank"
									rel="noopener"
								>
									User book
									<span class="arrow-link__arrow" aria-hidden="true">-&gt;</span
									>
								</a>
								<a
									class="arrow-link"
									href="https://architecture.cuprate.org"
									target="_blank"
									rel="noopener"
								>
									Architecture book
									<span class="arrow-link__arrow" aria-hidden="true">-&gt;</span
									>
								</a>
								<a
									class="arrow-link"
									href="https://doc.cuprate.org"
									target="_blank"
									rel="noopener"
								>
									Crates documentation
									<span class="arrow-link__arrow" aria-hidden="true">-&gt;</span
									>
								</a>
							</div>
						</LinkCard>
					</div>
					<LinkCard
						title="Repository"
						description="Explore the cource code, open issues, or follow the development on GitHub."
						href="https://github.com/Cuprate/cuprate"
					>
						<svg
							slot="icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
							<path
								d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"
							></path>
						</svg>
					</LinkCard>
					<LinkCard
						title="Blog"
						description="Development reports, meeting notes and announcements."
						href="/blog"
					>
						<svg
							slot="icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
							<path
								d="M16 6h3a1 1 0 0 1 1 1v11a2 2 0 0 1 -4 0v-13a1 1 0 0 0 -1 -1h-10a1 1 0 0 0 -1 1v12a3 3 0 0 0 3 3h11"
							></path>
							<path d="M8 8l4 0"></path>
							<path d="M8 12l4 0"></path>
							<path d="M8 16l4 0"></path>
						</svg>
					</LinkCard>
					<div class="explore__community">
						<CommunityBar />
					</div>
				</div>
			</section>

			<Contributors />
		</main>
		<Footer from="#070c12" />
	</body>
</html>

<style>
	.features {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 1000px) {
		.features {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.features {
			grid-template-columns: 1fr;
		}
	}

	.features__wide {
		grid-column: 1 / -1;
	}

	.explore {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 1.5rem;
	}

	.explore__main {
		grid-row: span 2;
		display: flex;
	}

	.explore__main :global(.link-card) {
		flex: 1;
		align-items: stretch;
	}

	.explore__main :global(.link-card__body) {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.explore__main :global(.link-card__arrow) {
		display: none;
	}

	.docs-links {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: auto;
		padding-top: 1.5rem;
	}

	.explore__community {
		grid-column: 1 / -1;
	}

	@media (max-width: 860px) {
		.explore {
			grid-template-columns: 1fr;
		}

		.explore__main {
			grid-row: auto;
		}
	}
</style>
