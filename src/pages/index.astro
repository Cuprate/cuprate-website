---
import Layout from "../layouts/Layout.astro";
import PixelHero from "../components/home/PixelHero.astro";
import LatestPostBar from "../components/home/LatestPostBar.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import LinkCard from "../components/ui/LinkCard.astro";
import Icon from "../components/ui/Icon.astro";
import PlatformSupport from "../components/home/PlatformSupport.astro";
import Contributors from "../components/home/Contributors.astro";
import CommunityBar from "../components/home/CommunityBar.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<Layout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	width="full"
	footerFrom="#070c12"
>
	<PixelHero />

	<LatestPostBar />

	<section class="section">
		<div class="features">
			<FeatureCard
				title="Rust Native"
				description="Written from the ground up in Rust. Memory safety, optimal concurrency, and asynchronous operations make every part of the node."
			>
				<Icon slot="icon" name="rust" size="1.6rem" />
			</FeatureCard>
			<FeatureCard
				title="Modular Design"
				description="Consensus, database, P2P, and RPC live in standalone MIT-licensed crates that you can reuse for your own needs."
			>
				<Icon slot="icon" name="modules" size="1.6rem" />
			</FeatureCard>
			<FeatureCard
				title="Security First"
				description="An alternative node implementation built with security at its core, auditing and hardening the Monero network through diversity."
			>
				<Icon slot="icon" name="shield" size="1.6rem" />
			</FeatureCard>
			<div class="features__wide">
				<PlatformSupport />
			</div>
		</div>
	</section>

	<section class="section">
		<h2 class="section__title">Explore</h2>
		<div class="explore">
			<div class="explore__main">
				<LinkCard
					title="Documentation"
					description="User and architecture books for Cuprate and the Monero protocol."
					badge="In Progress"
				>
					<Icon slot="icon" name="book" size="100%" />
					<div class="docs-links">
						<a
							class="arrow-link"
							href="https://user.cuprate.org"
							target="_blank"
							rel="noopener"
						>
							User book
							<span class="arrow-link__arrow" aria-hidden="true">-&gt;</span
							>
						</a>
						<a
							class="arrow-link"
							href="https://architecture.cuprate.org"
							target="_blank"
							rel="noopener"
						>
							Architecture book
							<span class="arrow-link__arrow" aria-hidden="true">-&gt;</span
							>
						</a>
						<a
							class="arrow-link"
							href="https://doc.cuprate.org"
							target="_blank"
							rel="noopener"
						>
							Crates documentation
							<span class="arrow-link__arrow" aria-hidden="true">-&gt;</span
							>
						</a>
					</div>
				</LinkCard>
			</div>
			<LinkCard
				title="Repository"
				description="Explore the source code, open issues, or follow the development on GitHub."
				href="https://github.com/Cuprate/cuprate"
			>
				<Icon slot="icon" name="github" size="100%" />
			</LinkCard>
			<LinkCard
				title="Blog"
				description="Development reports, meeting notes and announcements."
				href="/blog"
			>
				<Icon slot="icon" name="blog" size="100%" />
			</LinkCard>
			<div class="explore__community">
				<CommunityBar />
			</div>
		</div>
	</section>

	<Contributors />
</Layout>

<style>
	.features {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 1000px) {
		.features {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.features {
			grid-template-columns: 1fr;
		}
	}

	.features__wide {
		grid-column: 1 / -1;
	}

	.explore {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 1.5rem;
	}

	.explore__main {
		grid-row: span 2;
		display: flex;
	}

	.explore__main :global(.link-card) {
		flex: 1;
		align-items: stretch;
	}

	.explore__main :global(.link-card__body) {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.explore__main :global(.link-card__arrow) {
		display: none;
	}

	.docs-links {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: auto;
		padding-top: 1.5rem;
	}

	.explore__community {
		grid-column: 1 / -1;
	}

	@media (max-width: 860px) {
		.explore {
			grid-template-columns: 1fr;
		}

		.explore__main {
			grid-row: auto;
		}
	}
</style>
