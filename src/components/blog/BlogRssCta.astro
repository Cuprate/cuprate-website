---
import ChessboardDivider from "../ui/ChessboardDivider.astro";
import Icon from "../ui/Icon.astro";
---

<ChessboardDivider from="#0d1117" to="#070c12" rows={1} />
<div class="rss-band">
	<div class="rss-band__inner">
		<img
			class="rss-band__avatar"
			src="https://github.com/SyntheticBird45.png"
			alt="SyntheticBird"
			width="72"
			height="72"
			loading="lazy"
		/>
		<blockquote class="rss-band__quote">
			<p>
				We try to get these blog posts out quickly so don't hesitate to stick
				around with the RSS feed
			</p>
			<footer class="rss-band__attrib">- SyntheticBird45</footer>
		</blockquote>
		<a class="rss-band__link" href="/rss.xml" target="_blank" rel="noopener">
			<Icon name="rss" size="1.5rem" />
			<span class="sr-only">Subscribe to the RSS feed</span>
		</a>
	</div>
</div>

<style>
	.rss-band {
		background: #070c12;
		padding: 4.5rem 1rem 6rem;
	}

	.rss-band__inner {
		width: 90vw;
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.rss-band__avatar {
		width: 4.5rem;
		height: 4.5rem;
		border: 3px solid rgb(34, 41, 57);
		margin-bottom: 2rem;
	}

	.rss-band__quote {
		position: relative;
		max-width: 38rem;
		margin: 0 0 2.5rem;
		padding: 0 2.5rem;
		border-left-color: rgba(125, 155, 255, 0.35);
	}

	.rss-band__quote p {
		font-size: 1.25rem;
		font-style: italic;
		line-height: 1.6;
		color: rgb(var(--gray));
		margin: 0;
	}

	.rss-band__attrib {
		margin-top: 1.25rem;
		font-size: 0.9rem;
		letter-spacing: 0.08em;
		color: #7d9bff;
	}

	.rss-band__quote::before,
	.rss-band__quote::after {
		position: absolute;
		font-family: "Atkinson Hyperlegible", sans-serif;
		font-weight: 700;
		font-size: 3rem;
		line-height: 1;
		color: #7d9bff;
	}

	.rss-band__quote::before {
		content: "\201C";
		top: -0.75rem;
		left: 0;
	}

	.rss-band__quote::after {
		content: "\201D";
		bottom: -1.5rem;
		right: 0;
	}

	.rss-band__link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border: 1px dashed rgb(34, 41, 57);
		color: #7d9bff;
		transition:
			background 100ms steps(2),
			border-color 100ms steps(2),
			color 100ms steps(2);
	}

	.rss-band__link:hover {
		background: rgba(30, 86, 207, 0.06);
		border-color: rgba(30, 86, 207, 0.5);
		color: #e6edf3;
	}

</style>
