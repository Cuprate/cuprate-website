---
import HeaderLink from "./HeaderLink.astro";
import Icon from "../ui/Icon.astro";
---

<header>
	<nav>
		<div class="nav__brand">
			<a href="/" class="nav__logo"
				><img src="/CuprateLogoWhite.avif" alt="" /></a
			>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/releases">Download</HeaderLink>
			<a
				class="nav__gh"
				href="https://github.com/Cuprate/cuprate"
				target="_blank"
				rel="noopener"
				aria-label="GitHub repository"
			>
				<Icon name="github" size="1.25rem" />
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		border-bottom: 1px dashed rgb(34, 41, 57);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.nav__brand {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.nav__logo {
		padding: 0.5em 0;
	}

	.nav__logo img {
		display: block;
		height: 2.5rem;
	}

	.nav__gh {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px dashed rgb(34, 41, 57);
		color: #7d9bff;
		transition:
			background 100ms steps(2),
			border-color 100ms steps(2),
			color 100ms steps(2);
	}

	.nav__gh:hover {
		background: rgba(30, 86, 207, 0.06);
		border-color: rgba(30, 86, 207, 0.5);
		color: #e6edf3;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.internal-links a {
		padding: 0.9em 1.15em;
		font-family: "Atkinson", sans-serif;
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		color: rgb(var(--gray));
		transition:
			background 100ms steps(2),
			color 100ms steps(2);
	}

	.internal-links a:hover {
		background: rgba(30, 86, 207, 0.06);
		color: #7d9bff;
	}

	.internal-links a.active {
		color: #7d9bff;
		box-shadow: inset 0 -2px 0 #1e56cf;
	}

	@media (max-width: 720px) {
		header {
			padding: 0 0.5em;
		}

		.internal-links {
			gap: 0.5rem;
		}

		.internal-links a {
			padding: 0.75em 0.6em;
			font-size: 0.8rem;
		}
	}

	@media (max-width: 560px) {
		nav {
			flex-wrap: wrap;
			justify-content: center;
		}

		.nav__brand {
			width: 100%;
			justify-content: center;
		}
	}
</style>
