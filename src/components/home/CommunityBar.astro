---
import Icon from "../ui/Icon.astro";

const channels = [
	{
		name: "Matrix",
		href: "https://matrix.to/#/#cuprate:monero.social",
	},
	{
		name: "IRC",
		href: "https://web.libera.chat/#cuprate",
	},
];
---

<div class="community-bar pixel-card">
	<div class="community-bar__label">
		<span class="community-bar__icon">
			<Icon name="users" size="100%" />
		</span>
		<h3 class="community-bar__title">Community</h3>
	</div>
	<div class="community-bar__channels">
		{
			channels.map((c) => (
				<a class="arrow-link" href={c.href} target="_blank" rel="noopener">
					{c.name}
					<span class="arrow-link__arrow" aria-hidden="true">
						-&gt;
					</span>
				</a>
			))
		}
	</div>
</div>

<style>
	.community-bar {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		padding: 1.5rem 2rem;
	}

	.community-bar__label {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.community-bar__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.7rem;
		height: 1.7rem;
		color: #7d9bff;
		flex-shrink: 0;
	}

	.community-bar__title {
		font-family: "Atkinson", sans-serif;
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #e6edf3;
		margin: 0;
	}

	.community-bar__channels {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 2rem;
		margin-left: auto;
	}
</style>
