---
const channels = [
	{
		name: "Matrix",
		href: "https://matrix.to/#/#cuprate:monero.social",
	},
	{
		name: "IRC",
		href: "https://web.libera.chat/#cuprate",
	},
];
---

<div class="community-bar">
	<div class="community-bar__label">
		<span class="community-bar__icon">
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
				<path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
				<path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path>
				<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
				<path d="M21 21v-2a4 4 0 0 0 -3 -3.85"></path>
			</svg>
		</span>
		<h3 class="community-bar__title">Community</h3>
	</div>
	<div class="community-bar__channels">
		{
			channels.map((c) => (
				<a class="arrow-link" href={c.href} target="_blank" rel="noopener">
					{c.name}
					<span class="arrow-link__arrow" aria-hidden="true">
						-&gt;
					</span>
				</a>
			))
		}
	</div>
</div>

<style>
	.community-bar {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		background: #010409;
		border: 3px solid rgb(34, 41, 57);
		padding: 1.5rem 2rem;
		transition:
			transform 100ms steps(3),
			box-shadow 100ms steps(3),
			border-color 100ms steps(3);
	}

	.community-bar:hover {
		transform: translate(-4px, -4px);
		border-color: #1e56cf;
		box-shadow: 8px 8px 0 #1e56cf;
	}

	.community-bar__label {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.community-bar__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.7rem;
		height: 1.7rem;
		color: #7d9bff;
		flex-shrink: 0;
	}

	.community-bar__icon svg {
		width: 100%;
		height: 100%;
	}

	.community-bar__title {
		font-family: "Atkinson Hyperlegible", sans-serif;
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #e6edf3;
		margin: 0;
	}

	.community-bar__channels {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 2rem;
		margin-left: auto;
	}
</style>
