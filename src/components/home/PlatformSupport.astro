---
import Icon from "../ui/Icon.astro";
import { platforms } from "../../data/platforms";
---

<div class="platform-card pixel-card">
	<h3 class="platform-card__title">Platform Support</h3>
	<p class="platform-card__intro">
		We support major platforms as well as smaller ones.
	</p>
	{/* Names only; architectures are on the releases page. */}
	<div class="platform-card__list">
		{
			platforms.map((p) => (
				<div class="platform">
					<Icon name={p.icon} size="1.6rem" color="#7d9bff" />
					<span>{p.name}</span>
				</div>
			))
		}
	</div>
</div>

<style>
	.platform-card {
		padding: 2rem;
	}

	.platform-card__title {
		font-family: "Atkinson", sans-serif;
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		line-height: 1.4;
		color: #e6edf3;
		margin: 0 0 0.75rem;
	}

	.platform-card__intro {
		font-size: 1.05rem;
		line-height: 1.6;
		color: rgb(var(--gray));
		margin: 0 0 1.75rem;
	}

	.platform-card__list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem 2.5rem;
	}

	.platform {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-family: "Atkinson", sans-serif;
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #e6edf3;
	}
</style>
